{
  "name": "drifttype",
  "version": "0.0.1",
  "description": "Spatial text layouts for the web. Text on paths and pointer-reactive typography with zero dependencies.",
  "author": "Kaiyi Wong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiyiwong/drifttype.git"
  },
  "keywords": [
    "text",
    "typography",
    "svg",
    "path",
    "canvas",
    "layout",
    "animation",
    "accessibility"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsc && node --experimental-strip-types --test tests/*.test.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^5.7.0"
  }
}
